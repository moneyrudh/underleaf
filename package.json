{
  "name": "underleaf",
  "version": "0.1.0",
  "description": "Overleaf-style live LaTeX preview, running locally",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun src/server.ts",
    "dev:ui": "UNDERLEAF_DEV=1 bun src/server.ts",
    "pdf": "bun src/cli.ts pdf",
    "doctor": "bun src/cli.ts doctor",
    "new": "bun src/cli.ts new",
    "typecheck": "bunx --bun tsc --noEmit",
    "smoke": "bun scripts/smoke.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.2",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/stix-two-text": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
